  "prefixes": "PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>\nPREFIX crmdig: <http://www.ics.forth.gr/isl/CRMdig/>\nPREFIX dcat: <http://www.w3.org/ns/dcat#>\nPREFIX dct: <http://purl.org/dc/terms/>\nPREFIX fdo: <https://w3id.org/fdo-squirrel/>\n",
  "queries": [
    {
      "id": "fdos-with-type-and-licence",
      "title": {
        "en": "Every FDO with its type, licence and file count",
        "de": "Jedes FDO mit Typ, Lizenz und Dateizahl"
      },
      "intro": {
        "en": "The list the registry exists for, counted from the catalogue node outwards - the same query fdo-squirrel-registry runs as its own crosscheck against the facet page (queries.yaml, catalogue-overview).",
        "de": "Die Liste, fuer die die Registry existiert, vom Katalogknoten aus gezaehlt - dieselbe Abfrage, mit der fdo-squirrel-registry sich selbst gegen die Facettenseite gegenprueft (queries.yaml, catalogue-overview)."
      },
      "sparql": "SELECT ?fdo ?title ?type ?licence (COUNT(?distribution) AS ?files) WHERE {\n  ?catalogue a dcat:Catalog ; dcat:dataset ?fdo .\n  ?fdo dct:title ?title ; a ?type .\n  FILTER(STRSTARTS(STR(?type), STR(fdo:)))\n  OPTIONAL { ?fdo dct:license ?licence }\n  OPTIONAL { ?fdo dcat:distribution ?distribution }\n} GROUP BY ?fdo ?title ?type ?licence ORDER BY ?title\n"
    },
    {
      "id": "classes-with-counts",
      "title": {
        "en": "Classes used, with counts",
        "de": "Verwendete Klassen mit Anzahl"
      },
      "intro": {
        "en": "What occurs in this collection - the counterpart to the VoID statistics.",
        "de": "Was in dieser Sammlung vorkommt - die Gegenprobe zur VoID-Statistik."
      },
      "sparql": "SELECT ?class (COUNT(?s) AS ?count) WHERE {\n  ?s a ?class\n} GROUP BY ?class ORDER BY DESC(?count)"
    }
  ]
}
