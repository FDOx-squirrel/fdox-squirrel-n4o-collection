<https://github.com/FDOx-squirrel/fdo-squirrel-registry> a fabio:Database,
        dcat:Dataset ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dct:conformsTo <https://w3id.org/nfdi4objects/profile/v0.1> ;
    dct:creator [ a foaf:Person ;
            foaf:familyName "Thiery" ;
            foaf:givenName "Florian" ;
            foaf:name "Thiery, Florian" ;
            n4o:orcidId <https://orcid.org/0000-0002-3246-3531> ;
            schema:affiliation [ a foaf:Organization ;
                    foaf:name "Leibniz-Zentrum fuer Archaeologie (LEIZA)" ] ] ;
    dct:description "Eine Registry fuer FAIR Digital Objects, gebaut mit der FDOx-Squirrel- Referenzimplementierung: erntet FDO-Metadaten von Zenodo, buendelt sie zu einem an CIDOC CRM verankerten DCAT-Katalog, validiert ihn mit SHACL und veroeffentlicht eine Filter- und SPARQL-Oberflaeche als statische Seite. Diese Collection veroeffentlicht denselben CIDOC-CRM-verankerten Bundle (dist/fdo-registry-n4o.ttl) fuer den NFDI4Objects Knowledge Graph erneut."@de,
        "A registry for FAIR Digital Objects packaged with the FDOx Squirrel reference implementation: harvests FDO metadata published on Zenodo, bundles it into a DCAT catalogue anchored in CIDOC CRM, validates it with SHACL, and publishes a filter and SPARQL interface as a static site. This collection re-publishes the same CIDOC-CRM-anchored bundle (dist/fdo-registry-n4o.ttl) for the NFDI4Objects Knowledge Graph."@en ;
    dct:issued "2026-09-04"^^xsd:date ;
    dct:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dct:license <http://creativecommons.org/licenses/by/4.0/> ;
    dct:modified "2026-09-04"^^xsd:date ;
    dct:publisher [ a foaf:Organization ;
            foaf:name "Leibniz-Zentrum fuer Archaeologie (LEIZA)" ] ;
    dct:title "FDOx Registry"@de,
