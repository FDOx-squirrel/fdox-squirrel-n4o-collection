<file:///home/runner/work/fdox-squirrel-n4o-collection/fdox-squirrel-n4o-collection/classes-with-counts> a sh:SPARQLSelectExecutable ;
    dct:title "Verwendete Klassen mit Anzahl"@de,
        "Classes used, with counts"@en ;
    rdfs:comment "Was in dieser Sammlung vorkommt - die Gegenprobe zur VoID-Statistik."@de,
        "What occurs in this collection - the counterpart to the VoID statistics."@en ;
    sh:select """PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX crmdig: <http://www.ics.forth.gr/isl/CRMdig/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX fdo: <https://w3id.org/fdo-squirrel/>

SELECT ?class (COUNT(?s) AS ?count) WHERE {
  ?s a ?class
} GROUP BY ?class ORDER BY DESC(?count)
""" .

<file:///home/runner/work/fdox-squirrel-n4o-collection/fdox-squirrel-n4o-collection/fdos-with-type-and-licence> a sh:SPARQLSelectExecutable ;
    dct:title "Jedes FDO mit Typ, Lizenz und Dateizahl"@de,
        "Every FDO with its type, licence and file count"@en ;
    rdfs:comment "Die Liste, fuer die die Registry existiert, vom Katalogknoten aus gezaehlt - dieselbe Abfrage, mit der fdo-squirrel-registry sich selbst gegen die Facettenseite gegenprueft (queries.yaml, catalogue-overview)."@de,
        "The list the registry exists for, counted from the catalogue node outwards - the same query fdo-squirrel-registry runs as its own crosscheck against the facet page (queries.yaml, catalogue-overview)."@en ;
    sh:select """PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX crmdig: <http://www.ics.forth.gr/isl/CRMdig/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX fdo: <https://w3id.org/fdo-squirrel/>

SELECT ?fdo ?title ?type ?licence (COUNT(?distribution) AS ?files) WHERE {
  ?catalogue a dcat:Catalog ; dcat:dataset ?fdo .
  ?fdo dct:title ?title ; a ?type .
  FILTER(STRSTARTS(STR(?type), STR(fdo:)))
  OPTIONAL { ?fdo dct:license ?licence }
  OPTIONAL { ?fdo dcat:distribution ?distribution }
} GROUP BY ?fdo ?title ?type ?licence ORDER BY ?title
""" .

